PORT=3000

# PostgreSQL. Em banco hospedado (Neon etc.) é só usar DATABASE_URL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=wifi
DATABASE_PASSWORD=wifi
DATABASE_NAME=wifi
# DATABASE_URL=postgres://user:password@host:5432/db
DATABASE_SSL=false
DB_SYNC=true

RABBITMQ_URL=amqp://wifi:wifi@localhost:5672

# Origens liberadas no CORS, separadas por vírgula
FRONTEND_URL=http://localhost:5173,http://localhost:8080

# Dados de exemplo no boot (conexões só são criadas se a tabela estiver vazia)
SEED_STORES=true
SEED_CONNECTIONS=true
SEED_CONNECTIONS_COUNT=1500
